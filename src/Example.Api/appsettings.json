{
  "ConnectionStrings": {
    "Database": ""
  },
  "Authentication": {
    "Provider": "Keycloak",
    "Keycloak": {
      "Authority": "https://identity.example.com/realms/example",
      "Audience": "example-api",
      "RequireHttpsMetadata": true
    },
    "Cognito": {
      "Region": "",
      "UserPoolId": "",
      "ClientId": "",
      "Authority": "",
      "Audience": "",
      "ResourceServerIdentifier": "example-api",
      "RequireHttpsMetadata": true,
      "UseLocalStack": false
    },
    "EntraId": {
      "Instance": "https://login.microsoftonline.com/",
      "TenantId": "",
      "ClientId": "",
      "Audience": "",
      "AllowWebApiToBeAuthorizedByACL": true
    }
  },
  "OpenApi": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
