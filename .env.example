# Required by LocalStack. Obtain a development auth token from LocalStack.
LOCALSTACK_AUTH_TOKEN=

# Docker Compose host ports and local-only credentials.
POSTGRES_PORT=5433
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
LOCALSTACK_PORT=4566

# API environment variable overrides. Export these before running the API or migrations.
ConnectionStrings__Database=Host=localhost;Port=5433;Database=app;Username=postgres;Password=postgres
Authentication__Provider=Keycloak
Authentication__Keycloak__Authority=http://localhost:8080/realms/example
Authentication__Keycloak__Audience=example-api
Authentication__Keycloak__RequireHttpsMetadata=false
OpenApi__Enabled=true
